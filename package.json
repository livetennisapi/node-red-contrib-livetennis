{
  "name": "@livetennisapi/node-red-contrib-livetennis",
  "version": "0.1.0",
  "description": "Node-RED nodes for the Live Tennis API — live scores, matches, players and fixtures (ATP, WTA, Challenger, ITF, juniors)",
  "license": "MIT",
  "keywords": [
    "node-red",
    "tennis",
    "live-scores",
    "sports",
    "atp",
    "wta",
    "livetennisapi"
  ],
  "author": "Live Tennis API <hello@livetennisapi.com>",
  "homepage": "https://livetennisapi.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/livetennisapi/node-red-contrib-livetennis.git"
  },
  "bugs": {
    "url": "https://github.com/livetennisapi/node-red-contrib-livetennis/issues",
    "email": "hello@livetennisapi.com"
  },
  "engines": {
    "node": ">=18"
  },
  "node-red": {
    "version": ">=3.0.0",
    "nodes": {
      "livetennis-config": "nodes/livetennis-config.js",
      "live tennis": "nodes/live-tennis.js"
    }
  },
  "scripts": {
    "test": "mocha test/*_spec.js --timeout 10000",
    "lint": "eslint nodes test",
    "smoke": "mocha test/smoke/live_smoke.js --timeout 30000"
  },
  "files": [
    "nodes",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "eslint": "^9.0.0",
    "mocha": "^10.4.0",
    "node-red": "^4.0.0",
    "node-red-node-test-helper": "^0.3.4"
  }
}
